<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Player.ico</ApplicationIcon>
    <Product>Koma</Product>
    <Description>Local anime player for Windows</Description>
    <Version>0.1.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Strings/*.json" LogicalName="Koma.Strings.%(Filename)%(Extension)" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
    <Resource Include="Assets\Player.ico" />
    <None Update="player-input.conf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
