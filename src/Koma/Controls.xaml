<UserControl x:Class="Koma.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Focusable="False" SizeChanged="ResizeControls">
 <UserControl.Resources>
  <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="5"/><Setter Property="Margin" Value="0,0,3,0"/></Style>
  <Style x:Key="MenuButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,0,3,0"/></Style>
 </UserControl.Resources>
 <Border Padding="16,4,16,12" BorderBrush="#393347" BorderThickness="0,1,0,0">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#EB1B1928"/><GradientStop Color="#F50D0E17" Offset="1"/></LinearGradientBrush></Border.Background>
  <StackPanel>
   <Slider x:Name="Position" Margin="0,0,0,2" Minimum="0" AutomationProperties.Name="{DynamicResource Koma.Text.Playback position}" Foreground="{StaticResource AccentBrush}"/>
   <Grid Margin="0,0,0,5">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal">
     <Button x:Name="Previous" Style="{StaticResource TransportButton}" ToolTip="{DynamicResource Koma.Text.Previous episode}" AutomationProperties.Name="{DynamicResource Koma.Text.Previous episode}"><ui:SymbolIcon Symbol="Previous24"/></Button>
     <Button x:Name="Back" Style="{StaticResource TransportButton}" ToolTip="{DynamicResource Koma.Text.Seek backward}" AutomationProperties.Name="{DynamicResource Koma.Text.Seek backward}"><ui:SymbolIcon Symbol="ArrowLeft24"/></Button>
     <Button x:Name="Play" Style="{StaticResource TransportButton}" Background="#AC8DF5" Foreground="#120F1B"><ui:SymbolIcon x:Name="PlayIcon" Symbol="Play24"/></Button>
     <Button x:Name="Forward" Style="{StaticResource TransportButton}" ToolTip="{DynamicResource Koma.Text.Seek forward}" AutomationProperties.Name="{DynamicResource Koma.Text.Seek forward}"><ui:SymbolIcon Symbol="ArrowRight24"/></Button>
     <Button x:Name="Next" Style="{StaticResource TransportButton}" ToolTip="{DynamicResource Koma.Text.Next episode}" AutomationProperties.Name="{DynamicResource Koma.Text.Next episode}"><ui:SymbolIcon Symbol="Next24"/></Button>
     <TextBlock x:Name="Time" Text="0:00 / 0:00" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button x:Name="Mute" Style="{StaticResource TransportButton}"><ui:SymbolIcon x:Name="MuteIcon" Symbol="Speaker224"/></Button>
     <Slider x:Name="Volume" Width="64" Margin="0,0,12,0" Minimum="0" Maximum="100" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Koma.Text.Volume}"/>
     <Button x:Name="Fullscreen" Style="{StaticResource TransportButton}" ToolTip="{DynamicResource Koma.Text.Fullscreen}" AutomationProperties.Name="{DynamicResource Koma.Text.Fullscreen}"><ui:SymbolIcon x:Name="FullscreenIcon" Symbol="FullScreenMaximize24"/></Button>
    </StackPanel>
   </Grid>
   <DockPanel>
    <Button x:Name="Queue" DockPanel.Dock="Right" Style="{StaticResource TransportButton}" ToolTip="{DynamicResource Koma.Text.Toggle queue}" AutomationProperties.Name="{DynamicResource Koma.Text.Toggle queue}"><ui:SymbolIcon Symbol="List24"/></Button>
    <StackPanel Orientation="Horizontal">
     <Button x:Name="Speed" Style="{StaticResource MenuButton}" Content="1×" ToolTip="{DynamicResource Koma.Text.Playback speed}"/>
     <Button x:Name="Audio" Style="{StaticResource MenuButton}" Content="{DynamicResource Koma.Text.Audio}" ToolTip="{DynamicResource Koma.Text.Audio track}"/>
     <Button x:Name="Subtitles" Style="{StaticResource MenuButton}" Content="{DynamicResource Koma.Text.CC}" ToolTip="{DynamicResource Koma.Text.Subtitles}" AutomationProperties.Name="{DynamicResource Koma.Text.Subtitles}"/>
     <Button x:Name="Chapters" Style="{StaticResource MenuButton}" Content="{DynamicResource Koma.Text.Chapters}"/>
     <Button x:Name="Quality" Style="{StaticResource MenuButton}" Content="{DynamicResource Koma.Text.Upscaling · Auto}" Foreground="{StaticResource AccentBrush}" Background="#292139" ToolTip="{DynamicResource Koma.Text.Anime4K upscaling quality}"/>
     <Button x:Name="Compare" Style="{StaticResource MenuButton}" Content="{DynamicResource Koma.Text.Compare}" Visibility="Collapsed"/>
     <Button x:Name="More" Style="{StaticResource TransportButton}" ToolTip="{DynamicResource Koma.Text.More playback options}" AutomationProperties.Name="{DynamicResource Koma.Text.More playback options}"><ui:SymbolIcon Symbol="MoreHorizontal24"/></Button>
    </StackPanel>
   </DockPanel>
  </StackPanel>
 </Border>
</UserControl>
