<Window x:Class="Koma.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Koma" Icon="Assets/Player.ico" Width="1152" Height="760"
        MinWidth="680" MinHeight="440" WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14" AllowDrop="True"
        PreviewDragOver="DragIn" PreviewDrop="DropIn" PreviewKeyDown="WindowKey">
  <DockPanel>
    <Grid x:Name="Header" DockPanel.Dock="Top" Background="#181A25" Height="61">
      <DockPanel Margin="22,0,15,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="_Open video" Click="OpenFiles"/>
          <Button Content="_Settings" Click="OpenSettings"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Assets/Player.ico" Width="26" Height="26" Margin="0,0,9,0" VerticalAlignment="Center"/>
          <TextBlock Text="Koma" FontWeight="SemiBold" FontSize="19" VerticalAlignment="Center" Margin="0,0,24,0"/>
          <Button Content="_Home" Click="ShowHome"/>
          <Button x:Name="PlayerTab" Content="_Player" Click="ShowPlayer" IsEnabled="False"/>
        </StackPanel>
      </DockPanel>
    </Grid>
    <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Visibility="Collapsed" Padding="16,7" TextWrapping="Wrap" Background="#252135"/>
    <Grid>
      <Grid x:Name="HomePane" Margin="24,20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,16,0">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Saved folders" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,9"/>
            <WrapPanel Margin="0,0,0,8"><Button Content="Add folder" Click="AddFolder"/><Button Content="Refresh" Click="RefreshFolders"/></WrapPanel>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Content="Open Anime Folder" Click="OpenAnimeFolder" HorizontalContentAlignment="Left"/>
            <Button x:Name="Locate" Content="Locate folder" Click="LocateFolder" Visibility="Collapsed" Margin="0,6,6,0"/>
            <Button x:Name="RemoveRoot" Content="Remove saved folder" Click="RemoveFolder" Visibility="Collapsed" Margin="0,6,6,0"/>
          </StackPanel>
          <ListBox x:Name="Folders" DisplayMemberPath="Label" SelectionChanged="FolderSelected" AutomationProperties.Name="Saved folders"/>
        </DockPanel>
        <Grid Grid.Column="1">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border x:Name="ContinueCard" Background="#242238" CornerRadius="12" Padding="17" Margin="0,0,0,16" Visibility="Collapsed">
            <DockPanel>
              <Button x:Name="ContinueButton" DockPanel.Dock="Right" Content="Resume" Click="ContinueWatching" Background="#423465"/>
              <StackPanel><TextBlock Text="Continue Watching" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ContinueTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
            </DockPanel>
          </Border>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,10,0">
              <TextBlock DockPanel.Dock="Top" Text="Anime" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock DockPanel.Dock="Top" x:Name="LibraryMessage" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
              <TreeView x:Name="Shows" Background="Transparent" BorderThickness="0" SelectedItemChanged="SeasonSelected" AutomationProperties.Name="Shows and seasons"/>
            </DockPanel>
            <DockPanel Grid.Column="1">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button x:Name="PlaySeason" DockPanel.Dock="Right" Content="Play season" IsEnabled="False" Click="PlaySelectedSeason"/>
                <TextBlock x:Name="EpisodeHeading" Text="Episodes" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <ListBox x:Name="Episodes" DisplayMemberPath="Label" MouseDoubleClick="EpisodeDoubleClick" KeyDown="EpisodeKey" AutomationProperties.Name="Episodes"/>
            </DockPanel>
          </Grid>
        </Grid>
      </Grid>
      <DockPanel x:Name="PlayerPane" Visibility="Collapsed">
        <Grid x:Name="ControlsDock" DockPanel.Dock="Bottom"/>
        <DockPanel x:Name="QueuePane" DockPanel.Dock="Right" Width="245" Background="#181A25" Margin="0,0,0,0">
          <TextBlock x:Name="NowPlaying" DockPanel.Dock="Top" Padding="13,12" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
          <WrapPanel DockPanel.Dock="Bottom" Margin="8">
            <Button Content="Add" Click="AddToQueue"/>
            <Button Content="↑" ToolTip="Move episode up" AutomationProperties.Name="Move episode up" Click="QueueUp"/>
            <Button Content="↓" ToolTip="Move episode down" AutomationProperties.Name="Move episode down" Click="QueueDown"/>
            <Button Content="Remove" Click="RemoveEpisode"/>
          </WrapPanel>
          <ListBox x:Name="QueueList" DisplayMemberPath="Name" MouseDoubleClick="QueueDoubleClick" AutomationProperties.Name="Playback queue"/>
        </DockPanel>
        <Grid x:Name="VideoArea" Background="#07080C">
          <Grid.ColumnDefinitions><ColumnDefinition x:Name="ReferenceWidth" Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition x:Name="CompareHeight" Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Background="#242238"><TextBlock Text="Original" Margin="10,5" FontWeight="SemiBold"/></Border>
          <DockPanel Grid.Column="1" Background="#282338">
            <Button x:Name="Detail" DockPanel.Dock="Right" Content="Detail" Padding="10,3" Click="ToggleDetail"/>
            <TextBlock x:Name="CompareTitle" Text="Anime4K" Margin="10,5" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
          </DockPanel>
          <Border x:Name="ReferenceSlot" Grid.Row="1" Margin="0,0,2,0"/>
          <Border x:Name="VideoSlot" Grid.Row="1" Grid.Column="1"/>
        </Grid>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
